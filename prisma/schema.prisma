// ─────────────────────────────────────────────────────────────────────────────
// Orion — database schema
// Postgres (Neon / Supabase / Vercel Postgres). Pooled URL for the app,
// DIRECT_URL for migrations.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
}

enum SubscriptionStatus {
  ACTIVE
  TRIALING
  PAST_DUE
  CANCELED
  INCOMPLETE
  INCOMPLETE_EXPIRED
  UNPAID
  PAUSED
}

enum ProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DeploymentStatus {
  QUEUED
  PREPARING
  UPLOADING
  BUILDING
  SUCCESS
  FAILED
  DELETED
}

enum TemplateStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

enum TemplateTier {
  FREE
  PRO
}

// ─────────────────────────────────────────────────────────────── auth & users

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  plan          Plan      @default(FREE)

  // Server-enforced free-tier meters.
  downloadCount Int @default(0)
  projectCount  Int @default(0)

  stripeCustomerId String? @unique

  lastSeenAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  subscriptions  Subscription[]
  payments       Payment[]
  downloads      Download[]
  deployments    Deployment[]
  assets         ProjectAsset[]
  favorites      Favorite[]
  templateViews  TemplateView[]
  adminActivity  AdminActivity[]
  passwordResets PasswordResetToken[]
  verifications  EmailVerificationCode[]

  @@index([plan])
  @@index([role])
  @@index([createdAt])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// One-time numeric codes emailed at sign-up. The code itself is never stored —
/// only a SHA-256 hash — so a database leak cannot be replayed. `attempts`
/// bounds guessing: six digits is only a million combinations.
model EmailVerificationCode {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash String

  expires    DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ───────────────────────────────────────────────────────────────── templates

model Category {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  icon        String? // lucide icon name
  accent      String? // hex used by marketplace chips
  order       Int     @default(0)

  templates Template[]

  @@index([order])
}

model Tag {
  id    String @id @default(cuid())
  slug  String @unique
  name  String
  kind  String @default("tag") // tag | style | color | industry

  templates TemplateTag[]

  @@index([kind])
}

model TemplateTag {
  templateId String
  tagId      String

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([templateId, tagId])
  @@index([tagId])
}

model Template {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  description String @default("")

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  thumbnail  String?
  previewUrl String?

  // Where raw files live:
  //  bundled -> shipped in the repo under /templates/<sourceRef>
  //  blob    -> Vercel Blob prefix (admin ZIP upload) at <sourceRef>
  //  db      -> rows in TemplateFile
  storage   String @default("bundled")
  sourceRef String @default("")

  entryFile String   @default("index.html")
  pages     String[] @default([]) // additional html entrypoints

  // Editable element schema discovered at import/upload time:
  // [{ key, type, file, selector, label, group }]
  editableElements Json @default("[]")

  status   TemplateStatus @default(PUBLISHED)
  tier     TemplateTier   @default(FREE)
  featured Boolean        @default(false)
  isNew    Boolean        @default(true)

  // Licensing + attribution (mandatory for imported work).
  license     String  @default("MIT")
  author      String?
  source      String? // upstream repo / site
  attribution String? // required credit line, rendered in template detail + export

  colorScheme String  @default("dark") // dark | light | colorful
  responsive  Boolean @default(true)
  fileCount   Int     @default(0)
  totalBytes  Int     @default(0)

  viewCount     Int @default(0)
  usageCount    Int @default(0)
  favoriteCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files     TemplateFile[]
  tags      TemplateTag[]
  projects  Project[]
  favorites Favorite[]
  views     TemplateView[]

  @@index([status, featured])
  @@index([status, usageCount])
  @@index([status, createdAt])
  @@index([categoryId])
  @@index([tier])
}

// Only used when storage = "db" (admin ZIP uploads land here so the app has
// zero filesystem dependency in production).
model TemplateFile {
  id         String @id @default(cuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  path     String // normalised, relative, no leading slash
  mimeType String @default("text/plain")
  size     Int    @default(0)

  content String? @db.Text // text assets (html/css/js/svg)
  url     String? // binary assets offloaded to blob storage

  @@unique([templateId, path])
  @@index([templateId])
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  templateId String
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@unique([userId, templateId])
  @@index([userId, createdAt])
}

// Powers "recently viewed" + popularity analytics. No PII beyond user id.
model TemplateView {
  id         String   @id @default(cuid())
  templateId String
  userId     String?
  createdAt  DateTime @default(now())

  template Template @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([templateId, createdAt])
  @@index([userId, createdAt])
}

// ────────────────────────────────────────────────────────────────── projects

model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  name      String
  slug      String
  status    ProjectStatus @default(DRAFT)
  thumbnail String?

  /// Claimed Cloudflare Pages project name. Unique across the whole platform so
  /// two users cannot fight over the same *.pages.dev host.
  subdomain String? @unique

  // Editor state — the single source of truth for generated output.
  //   content: { "<editable key>": { text?, html?, src?, alt?, href?, hidden?, style? } }
  //   theme:   { vars: {...}, fontFamily, headingFont, radius }
  //   meta:    { title, description, favicon, ogImage }
  content Json @default("{}")
  theme   Json @default("{}")
  meta    Json @default("{}")

  // Monotonic counter bumped on every autosave; guards against stale writes.
  revision Int @default(0)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastEditedAt DateTime?

  deployments Deployment[]
  downloads   Download[]
  assets      ProjectAsset[]
  versions    ProjectVersion[]

  @@unique([userId, slug])
  @@index([userId, updatedAt])
  @@index([templateId])
}

model ProjectVersion {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  label    String?
  revision Int     @default(0)
  content  Json    @default("{}")
  theme    Json    @default("{}")
  meta     Json    @default("{}")

  createdAt DateTime @default(now())

  @@index([projectId, createdAt])
}

model ProjectAsset {
  id     String  @id @default(cuid())
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  url      String
  pathname String
  name     String  @default("")
  size     Int     @default(0)
  mimeType String  @default("image/png")
  width    Int?
  height   Int?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([projectId])
}

model Deployment {
  id        String @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  provider String           @default("cloudflare-pages")
  status   DeploymentStatus @default(QUEUED)

  projectName String // cloudflare pages project name
  url         String?
  aliasUrl    String?
  externalId  String?

  fileCount Int @default(0)
  bytes     Int @default(0)

  // Step-by-step progress shown in the deploy dialog:
  // [{ step, status, at, detail? }]
  steps Json    @default("[]")
  error String? @db.Text

  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@index([status])
}

model Download {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  bytes     Int      @default(0)
  fileCount Int      @default(0)
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────── billing

model Subscription {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String             @unique
  stripeCustomerId     String
  stripePriceId        String
  status               SubscriptionStatus @default(INCOMPLETE)

  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean   @default(false)
  canceledAt         DateTime?
  endedAt            DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// Settled Stripe money movements. Source of truth for the earnings report —
// written only by the verified webhook.
model Payment {
  id     String  @id @default(cuid())
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  stripeEventId   String  @unique
  stripeInvoiceId String?
  stripeChargeId  String?
  stripeCustomerId String?

  amount   Int // minor units
  refunded Int    @default(0)
  currency String @default("usd")
  status   String @default("succeeded") // succeeded | refunded | failed

  description String?
  periodStart DateTime?
  periodEnd   DateTime?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

// Idempotency guard so a replayed Stripe webhook cannot double-count revenue.
model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@index([processedAt])
}

// ──────────────────────────────────────────────────────── ops / admin / abuse

model AdminActivity {
  id     String @id @default(cuid())
  userId String?
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  action   String // template.create, template.delete, user.role_change …
  target   String?
  targetId String?
  metadata Json    @default("{}")
  ip       String?

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([action])
}

// Durable sliding-window rate limiting. Works on serverless without Redis;
// swap for Upstash by implementing the same interface in lib/security.
model RateLimitHit {
  id        String   @id @default(cuid())
  bucket    String // "<action>:<identifier>"
  createdAt DateTime @default(now())

  @@index([bucket, createdAt])
}
