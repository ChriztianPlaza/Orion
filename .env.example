# ─────────────────────────────────────────────────────────────────────────────
# Orion — environment
#
# Copy to .env.local for development, or paste into Vercel's project settings.
# Never commit real values.
#
# The app boots with only DATABASE_URL and AUTH_SECRET set. Each integration
# below unlocks a feature and, until it is configured, the UI says so plainly
# instead of failing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (required) ──────────────────────────────────────────────────────
# Postgres. Neon, Supabase and Vercel Postgres all work.
# DATABASE_URL is the pooled connection used at runtime.
# DIRECT_URL is the unpooled connection used for migrations.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# ── Authentication (required) ────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Only needed when the deployment URL cannot be inferred (e.g. behind a proxy).
AUTH_URL=""
# Public origin used in emails, sitemaps and Stripe redirects.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional social sign-in. Leave blank to show email/password only.
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails promoted to ADMIN on sign-in. Use this to bootstrap
# the first administrator, then remove it.
ADMIN_EMAILS=""

# ── Billing — Stripe (enables the Pro plan) ─────────────────────────────────
# STRIPE_PRICE_ID is the recurring $20/month price id (starts with "price_").
# STRIPE_WEBHOOK_SECRET comes from the endpoint you register at
#   https://your-domain/api/stripe/webhook
# subscribed to: checkout.session.completed, customer.subscription.created,
# customer.subscription.updated, customer.subscription.deleted, invoice.paid,
# invoice.payment_failed, charge.refunded
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_ID=""

# ── Deployment — Cloudflare Pages (enables Pro deployments) ─────────────────
# Create an API token with the "Cloudflare Pages: Edit" permission.
# This value is server-only and is never sent to the browser.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
# Override only if you serve deployments from a custom Pages domain.
CLOUDFLARE_PAGES_DOMAIN="pages.dev"

# ── Object storage — Vercel Blob (enables image uploads) ────────────────────
# Created automatically when you add a Blob store to the Vercel project.
BLOB_READ_WRITE_TOKEN=""

# ── Email — Resend (enables password reset delivery) ───────────────────────
RESEND_API_KEY=""
EMAIL_FROM="Orion <no-reply@your-domain.com>"

# ── Template importing (optional) ──────────────────────────────────────────
# Raises the GitHub API rate limit for `npm run templates:import`.
GITHUB_TOKEN=""

# ── Seeding (optional) ──────────────────────────────────────────────────────
# Used once by `npm run db:seed` to create the first administrator.
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""
